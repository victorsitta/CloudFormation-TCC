# ============================================================
# Variáveis de ambiente para integração com a infra AWS
# Equipe MVP — copie este arquivo para .env e preencha
# os valores após fazer o deploy do CloudFormation
# ============================================================

# URL base do API Gateway — obtida nos Outputs do CloudFormation
# Exemplo: https://abc123.execute-api.us-east-1.amazonaws.com/simulation
API_GATEWAY_URL=

# ARN do tópico SNS — para subscrever e receber notificações de eventos
# Eventos: UPLOADED, ARCHIVED, ERROR
SNS_TOPIC_ARN=

# Nome da tabela DynamoDB (apenas para referência — não aceder diretamente)
DYNAMODB_TABLE_NAME=docsaas-documents-simulation

# Nome dos buckets S3 (apenas para referência — não aceder diretamente)
S3_STANDARD_BUCKET=docsaas-standard-simulation-{accountId}
S3_GLACIER_BUCKET=docsaas-glacier-simulation-{accountId}

# ============================================================
# Como obter os valores após o deploy:
#
# aws cloudformation describe-stacks \
#   --stack-name docsaas-simulation \
#   --query 'Stacks[0].Outputs'
# ============================================================
